# Copy these into Netlify → Site settings → Environment variables.
# Do NOT commit real values to GitHub.

# SAM.gov public API key (Account Details page on SAM.gov, enter your password to reveal)
SAM_API_KEY=

# Supabase project
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=        # service_role key (server-side only — never expose client-side)

# Resend
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@aproposgroupllc.com   # must be on a Resend-verified domain
ALERT_EMAIL_TO=jmitchell@aproposgroupllc.com       # comma-separate for multiple recipients

# Tuning (optional — these are the defaults baked into the code)
APROPOS_GROUP_NAICS_CODES=541511,541512,541519,541611,541614,541618
LOOKBACK_DAYS=2
